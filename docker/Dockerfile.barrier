# syntax=docker/dockerfile:1

# Runtime image for the Joltrin verification barrier over MCP streamable HTTP
# (sop-mcp-server http). Single tenant: one token, one trace namespace.
# Not built or published by any workflow yet.

# ==============================================================================
# Stage 1: Builder
# ==============================================================================
FROM golang:1.27.4-alpine AS builder

WORKDIR /src

# Download modules before copying source so this layer is cached across
# source-only changes and only re-runs when go.mod/go.sum change.
COPY go.work go.work.sum* ./
COPY go.mod go.sum ./
COPY adapters/cassandra/go.mod adapters/cassandra/go.sum* ./adapters/cassandra/
COPY adapters/nats/go.mod adapters/nats/go.sum* ./adapters/nats/
COPY adapters/redis/go.mod adapters/redis/go.sum* ./adapters/redis/
COPY ai/go.mod ai/go.sum* ./ai/
COPY incfs/go.mod incfs/go.sum* ./incfs/
COPY infs/go.mod infs/go.sum* ./infs/
COPY jsondb/go.mod jsondb/go.sum* ./jsondb/
COPY search/go.mod search/go.sum* ./search/

RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/sop-mcp-server ./cmd/sop-mcp-server

# ==============================================================================
# Stage 2: Minimal Distroless Non-Root Runtime
# ==============================================================================
FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=builder /out/sop-mcp-server /sop-mcp-server

USER nonroot:nonroot
EXPOSE 8088

# Listens on all interfaces inside the container, so SOP_MCP_TOKEN is required.
ENTRYPOINT ["/sop-mcp-server", "http", "--addr", "0.0.0.0:8088"]
