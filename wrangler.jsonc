{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "joltrin-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "directory": "./_site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "joltrinhq.com", "custom_domain": true },
    { "pattern": "www.joltrinhq.com", "custom_domain": true }
  ],
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [
    { "name": "CONTACT_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "workers_dev": true,
  "preview_urls": true
}
