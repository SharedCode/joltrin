<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>Sop4CS</PackageId>
    <Version>5.4.0</Version>
    <Authors>Gerardo Recinto</Authors>
    <Description>Joltrin (distributed as Sop4CS) - Durable memory and verification infrastructure for AI agents.</Description>
    <PackageTags>database;btree;vector;storage;transactional;ai-memory</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/SharedCode/joltrin</RepositoryUrl>
    <LangVersion>latest</LangVersion>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Include="libjsondb.dylib" Condition="Exists('libjsondb.dylib')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="libjsondb_amd64darwin.dylib" Link="runtimes/osx-x64/native/libjsondb.dylib" Condition="Exists('libjsondb_amd64darwin.dylib')">
      <Pack>true</Pack>
      <PackagePath>runtimes/osx-x64/native/libjsondb.dylib</PackagePath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="libjsondb_amd64linux.so" Link="runtimes/linux-x64/native/libjsondb.so" Condition="Exists('libjsondb_amd64linux.so')">
      <Pack>true</Pack>
      <PackagePath>runtimes/linux-x64/native/libjsondb.so</PackagePath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="libjsondb_amd64windows.dll" Link="runtimes/win-x64/native/libjsondb.dll" Condition="Exists('libjsondb_amd64windows.dll')">
      <Pack>true</Pack>
      <PackagePath>runtimes/win-x64/native/libjsondb.dll</PackagePath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="libjsondb_arm64darwin.dylib" Link="runtimes/osx-arm64/native/libjsondb.dylib" Condition="Exists('libjsondb_arm64darwin.dylib')">
      <Pack>true</Pack>
      <PackagePath>runtimes/osx-arm64/native/libjsondb.dylib</PackagePath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="libjsondb_arm64linux.so" Link="runtimes/linux-arm64/native/libjsondb.so" Condition="Exists('libjsondb_arm64linux.so')">
      <Pack>true</Pack>
      <PackagePath>runtimes/linux-arm64/native/libjsondb.so</PackagePath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="libjsondb_arm64windows.dll" Link="runtimes/win-arm64/native/libjsondb.dll" Condition="Exists('libjsondb_arm64windows.dll')">
      <Pack>true</Pack>
      <PackagePath>runtimes/win-arm64/native/libjsondb.dll</PackagePath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
